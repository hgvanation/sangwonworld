// Dán nội dung này vào Firebase Console → Firestore Database → Rules → Publish
// THAY email admin ở dòng "allow write" (có thể thêm nhiều email trong [ ]).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /content/{doc} {
      allow read: if true;   // ai cũng xem được nội dung
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email in ['email-cua-ban@gmail.com'];
    }
  }
}
